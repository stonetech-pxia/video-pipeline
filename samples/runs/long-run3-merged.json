  "dialogue": [
    {
      "id": "D001",
      "speaker_id": null,
      "beat_id": "B004",
      "text": "「你答应过要回来的。」",
      "parenthetical": "照片背面的手写字"
    },
    {
      "id": "D002",
      "speaker_id": "C01",
      "beat_id": "B006",
      "text": "问老板娘认不认识照片里的女孩。",
      "parenthetical": "递照片"
    },
    {
      "id": "D003",
      "speaker_id": "C02",
      "beat_id": "B007",
      "text": "这不是灯塔那边林家的姑娘吗，好多年没见了。",
      "parenthetical": null
    },
    {
      "id": "D004",
      "speaker_id": "C01",
      "beat_id": "B008",
      "text": "问她姓什么。",
      "parenthetical": null
    },
    {
      "id": "D005",
      "speaker_id": "C02",
      "beat_id": "B008",
      "text": "想不起来了。",
      "parenthetical": null
    },
    {
      "id": "D006",
      "speaker_id": "C03",
      "beat_id": "B014",
      "text": "林家的女儿十二年前出过事，你不记得了？",
      "parenthetical": null
    },
    {
      "id": "D007",
      "speaker_id": "C01",
      "beat_id": "B015",
      "text": "我不记得。",
      "parenthetical": null
    },
    {
      "id": "D008",
      "speaker_id": "C03",
      "beat_id": "B016",
      "text": "那年你也在。",
      "parenthetical": "沉默片刻后低声说"
    },
    {
      "id": "D009",
      "speaker_id": "C04",
      "beat_id": "B023",
      "text": "叫出周砚的名字。",
      "parenthetical": "认了很久之后"
    },
    {
      "id": "D010",
      "speaker_id": "C04",
      "beat_id": "B024",
      "text": "那年翻车，救出来两个孩子，只活了一个。",
      "parenthetical": null
    },
    {
      "id": "D011",
      "speaker_id": "C04",
      "beat_id": "B025",
      "text": "你一直以为活下来的是你。",
      "parenthetical": "拍着周砚的手"
    }
  ],
