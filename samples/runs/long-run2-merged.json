  "dialogue": [
    {
      "id": "D001",
      "speaker_id": "C04",
      "beat_id": "B008",
      "text": "这不是灯塔那边林家的姑娘吗，好多年没见了。",
      "parenthetical": null
    },
    {
      "id": "D002",
      "speaker_id": "C01",
      "beat_id": "B009",
      "text": "她姓什么？",
      "parenthetical": null
    },
    {
      "id": "D003",
      "speaker_id": "C04",
      "beat_id": "B009",
      "text": "想不起来了。",
      "parenthetical": null
    },
    {
      "id": "D004",
      "speaker_id": "C03",
      "beat_id": "B015",
      "text": "林家的女儿十二年前出过事，你不记得了？",
      "parenthetical": null
    },
    {
      "id": "D005",
      "speaker_id": "C01",
      "beat_id": "B016",
      "text": "我不记得。",
      "parenthetical": null
    },
    {
      "id": "D006",
      "speaker_id": "C03",
      "beat_id": "B017",
      "text": "那年你也在。",
      "parenthetical": "沉默了一会儿之后"
    },
    {
      "id": "D007",
      "speaker_id": "C02",
      "beat_id": "B027",
      "text": "砚……",
      "parenthetical": "端详了很久才认出并叫出名字"
    },
    {
      "id": "D009",
      "speaker_id": "C02",
      "beat_id": "B028",
      "text": "那年翻车，救出来两个孩子，只活了一个。",
      "parenthetical": null
    },
    {
      "id": "D008",
      "speaker_id": "C02",
      "beat_id": "B029",
      "text": "你一直以为活下来的是你。",
      "parenthetical": "拍拍周砚的手"
    }
  ],
