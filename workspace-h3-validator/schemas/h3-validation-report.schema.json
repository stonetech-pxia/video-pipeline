{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/h3-validation-report.schema.json",
  "title": "H3 Unified Semantic Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "deterministic_gate", "error_class", "errors", "warnings", "segment_checks", "validated_packages"],
  "properties": {
    "schema_version": { "const": "1.3" },
    "status": { "enum": ["PASS", "FAIL"] },
    "deterministic_gate": { "$ref": "#/$defs/deterministicGate" },
    "error_class": { "type": "array", "uniqueItems": true, "items": { "enum": ["STORY", "SHOT_DESIGN", "FRAME_DESIGN", "MEDIA", "TIMELINE", "H3_SCHEMA", "FORMAT"] } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "segment_checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segmentCheck" } },
    "validated_packages": { "type": "array", "items": { "type": "object" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "deterministic_gate": { "properties": { "status": { "const": "PASS" } } },
          "error_class": { "maxItems": 0 },
          "errors": { "maxItems": 0 },
          "validated_packages": { "minItems": 1 },
          "segment_checks": {
            "items": {
              "properties": {
                "source_fidelity_valid": { "const": true },
                "unified_syntax_valid": { "const": true },
                "entry_strategy_valid": { "const": true },
                "frame_link_valid": { "const": true },
                "reference_bundle_valid": { "const": true },
                "runtime_tail_dependency_valid": { "const": true },
                "continuation_prompt_valid": { "const": true },
                "errors": { "maxItems": 0 }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] },
      "then": { "properties": { "errors": { "minItems": 1 }, "validated_packages": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "deterministicGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report_id"],
      "properties": {
        "status": { "const": "PASS" },
        "report_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message", "owner", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "message": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["video-pipeline", "story-analyst", "shot-director", "frame-designer", "media-resolution", "h3-compiler", "h3-validator"] },
        "retryable": { "type": "boolean" }
      }
    },
    "segmentCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "source_fidelity_valid", "unified_syntax_valid", "entry_strategy_valid", "frame_link_valid", "reference_bundle_valid", "runtime_tail_dependency_valid", "continuation_prompt_valid", "errors", "warnings"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "source_fidelity_valid": { "type": "boolean" },
        "unified_syntax_valid": { "type": "boolean" },
        "entry_strategy_valid": { "type": "boolean" },
        "frame_link_valid": { "type": "boolean" },
        "reference_bundle_valid": { "type": "boolean" },
        "runtime_tail_dependency_valid": { "type": "boolean" },
        "continuation_prompt_valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    }
  }
}
