{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/story-plan.schema.json",
  "title": "Story Plan",
  "description": "Pass 0 of a chunked breakdown: the scene spine, the global entity registry, and the chunk grouping. Small enough to emit reliably in one turn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "duration",
    "scenes",
    "characters",
    "locations",
    "props",
    "continuity_constraints",
    "locked_constraints",
    "ambiguities",
    "chunks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "duration": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plannedScene"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "continuity_constraints": {
      "type": "array",
      "description": "Cross-scene locks only. Scene-local constraints belong to the chunk that owns the scene.",
      "items": {
        "$ref": "#/$defs/continuityConstraint"
      }
    },
    "locked_constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "plannedScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slugline",
        "location_id",
        "time_of_day",
        "duration_budget",
        "synopsis",
        "estimated_beats"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slugline": {
          "type": "string",
          "minLength": 1
        },
        "location_id": {
          "$ref": "#/$defs/id"
        },
        "time_of_day": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_budget": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "synopsis": {
          "type": "string",
          "minLength": 1
        },
        "estimated_beats": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scene_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scene_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "wardrobe",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "wardrobe": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "continuityConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "subject_id",
        "rule",
        "scope",
        "locked"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "identity",
            "wardrobe",
            "prop",
            "scene",
            "weather",
            "time",
            "space"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "#/$defs/id"
                },
                "to": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          ]
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "severity",
        "question"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "enum": [
            "blocking",
            "medium",
            "low"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
