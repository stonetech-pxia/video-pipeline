{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/story-ir-chunk.schema.json",
  "title": "Story IR Chunk",
  "description": "Pass N of a chunked breakdown: the beats, dialogue, and scene-local continuity for the scenes one chunk owns. Field shapes match story-ir.schema.json exactly, so a chunk that validates here survives the merge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "scenes",
    "beats",
    "dialogue",
    "continuity_constraints",
    "transition_markers",
    "ambiguities"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "chunk_id": { "$ref": "#/$defs/id" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sceneCompletion" }
    },
    "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beat" } },
    "dialogue": { "type": "array", "items": { "$ref": "#/$defs/dialogueLine" } },
    "continuity_constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/continuityConstraint" }
    },
    "transition_markers": {
      "type": "array",
      "items": { "$ref": "#/$defs/transitionMarker" }
    },
    "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/ambiguity" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sceneCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "beat_ids", "exit_state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "beat_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "exit_state": { "type": ["string", "null"] }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scene_id", "action", "emotion", "entity_ids", "dialogue_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scene_id": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "minLength": 1 },
        "emotion": { "type": ["string", "null"] },
        "entity_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "dialogue_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "dialogueLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speaker_id", "beat_id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "speaker_id": { "type": ["string", "null"] },
        "beat_id": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "parenthetical": { "type": ["string", "null"] }
      }
    },
    "continuityConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "subject_id", "rule", "scope", "locked"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": {
          "enum": ["identity", "wardrobe", "prop", "scene", "weather", "time", "space"]
        },
        "subject_id": { "type": ["string", "null"] },
        "rule": { "type": "string", "minLength": 1 },
        "scope": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/id" } },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "$ref": "#/$defs/id" },
                "to": { "$ref": "#/$defs/id" }
              }
            }
          ]
        },
        "locked": { "type": "boolean" }
      }
    },
    "transitionMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_id", "at_beat_id", "type", "from", "to", "reason"],
      "properties": {
        "marker_id": { "$ref": "#/$defs/id" },
        "at_beat_id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "scene_change",
            "time_change",
            "location_change",
            "weather_change",
            "continuity_break"
          ]
        },
        "from": { "type": ["string", "object", "null"] },
        "to": { "type": ["string", "object", "null"] },
        "reason": { "type": "string" }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "severity", "question"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["blocking", "medium", "low"] },
        "subject_id": { "type": ["string", "null"] },
        "field": { "type": ["string", "null"] },
        "question": { "type": "string", "minLength": 1 }
      }
    }
  }
}
