{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/frame-design-output.schema.json",
  "title": "Frame Design Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "segment_plan", "frame_plan", "image_jobs", "media_manifest", "warnings", "errors"],
  "properties": {
    "schema_version": { "const": "1.2" },
    "status": { "enum": ["complete", "partial", "blocked"] },
    "segment_plan": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } },
    "frame_plan": { "type": "array", "items": { "$ref": "#/$defs/framePlanItem" } },
    "image_jobs": { "type": "array", "items": { "$ref": "#/$defs/imageJob" } },
    "media_manifest": { "$ref": "#/$defs/mediaManifest" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "nullableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "referenceStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_reference_ids", "location_reference_ids", "style_reference_ids", "video_reference_ids", "audio_reference_ids"],
      "properties": {
        "character_reference_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "location_reference_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "style_reference_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "video_reference_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "audio_reference_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "continuityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_same_shot", "continuous_action", "continuous_camera", "same_scene", "same_framing", "same_camera_position", "same_time", "same_visual_focus", "requires_recomposition", "change_triggers", "decision"],
      "properties": {
        "is_same_shot": { "type": "boolean" },
        "continuous_action": { "type": "boolean" },
        "continuous_camera": { "type": "boolean" },
        "same_scene": { "type": "boolean" },
        "same_framing": { "type": "boolean" },
        "same_camera_position": { "type": "boolean" },
        "same_time": { "type": "boolean" },
        "same_visual_focus": { "type": "boolean" },
        "requires_recomposition": { "type": "boolean" },
        "change_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["shot", "framing", "camera_position", "scene", "location", "time", "visual_focus", "blocking", "composition", "spatial_relationship"] }
        },
        "decision": { "enum": ["generate_new_first_frame", "reuse_previous_tail"] }
      }
    },
    "runtimeEntryDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "previous_segment_id", "expected_media_id"],
      "properties": {
        "kind": { "const": "previous_actual_tail_frame" },
        "previous_segment_id": { "$ref": "#/$defs/id" },
        "expected_media_id": { "$ref": "#/$defs/id" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "shot_ids", "shot_bindings", "previous_segment_id", "start", "end", "duration", "entry_strategy", "entry_frame_source", "runtime_entry_dependency", "exit_frame_required", "last_frame_target_media_id", "actual_tail_frame_media_id", "reference_strategy", "continuity_decision", "reason"],
      "properties": {
        "segment_id": { "$ref": "#/$defs/id" },
        "shot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "shot_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt_shot_index", "shot_id", "local_start"],
            "properties": {
              "prompt_shot_index": { "type": "integer", "minimum": 1 },
              "shot_id": { "$ref": "#/$defs/id" },
              "local_start": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "previous_segment_id": { "$ref": "#/$defs/nullableId" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 4 },
        "duration": { "type": "integer", "minimum": 4, "maximum": 15 },
        "entry_strategy": { "enum": ["new_first_frame", "use_previous_tail_frame"] },
        "entry_frame_source": { "$ref": "#/$defs/nullableId" },
        "runtime_entry_dependency": { "oneOf": [{ "$ref": "#/$defs/runtimeEntryDependency" }, { "type": "null" }] },
        "exit_frame_required": { "type": "boolean" },
        "last_frame_target_media_id": { "$ref": "#/$defs/nullableId" },
        "actual_tail_frame_media_id": { "$ref": "#/$defs/nullableId" },
        "reference_strategy": { "$ref": "#/$defs/referenceStrategy" },
        "continuity_decision": { "$ref": "#/$defs/continuityDecision" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "entry_strategy": { "const": "new_first_frame" } }, "required": ["entry_strategy"] },
          "then": {
            "properties": {
              "entry_frame_source": { "$ref": "#/$defs/id" },
              "runtime_entry_dependency": { "type": "null" },
              "continuity_decision": { "properties": { "decision": { "const": "generate_new_first_frame" } } }
            }
          }
        },
        {
          "if": { "properties": { "entry_strategy": { "const": "use_previous_tail_frame" } }, "required": ["entry_strategy"] },
          "then": {
            "properties": {
              "previous_segment_id": { "$ref": "#/$defs/id" },
              "entry_frame_source": { "type": "null" },
              "runtime_entry_dependency": { "$ref": "#/$defs/runtimeEntryDependency" },
              "continuity_decision": {
                "properties": {
                  "is_same_shot": { "const": true },
                  "continuous_action": { "const": true },
                  "continuous_camera": { "const": true },
                  "same_scene": { "const": true },
                  "same_framing": { "const": true },
                  "same_camera_position": { "const": true },
                  "same_time": { "const": true },
                  "same_visual_focus": { "const": true },
                  "requires_recomposition": { "const": false },
                  "change_triggers": { "maxItems": 0 },
                  "decision": { "const": "reuse_previous_tail" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "exit_frame_required": { "const": true } }, "required": ["exit_frame_required"] },
          "then": { "properties": { "actual_tail_frame_media_id": { "$ref": "#/$defs/id" } } }
        }
      ]
    },
    "framePlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "first_frame_media_id", "last_frame_target_media_id", "actual_tail_frame_media_id", "reference_media_ids"],
      "properties": {
        "segment_id": { "$ref": "#/$defs/id" },
        "first_frame_media_id": { "$ref": "#/$defs/nullableId" },
        "last_frame_target_media_id": { "$ref": "#/$defs/nullableId" },
        "actual_tail_frame_media_id": { "$ref": "#/$defs/nullableId" },
        "reference_media_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "imageJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "type", "role", "related_segments", "prompt", "negative_prompt", "output_media_id", "status"],
      "properties": {
        "job_id": { "$ref": "#/$defs/id" },
        "type": { "const": "image_generation" },
        "role": { "enum": ["character_reference", "location_reference", "style_reference", "first_frame", "last_frame_target"] },
        "related_segments": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "prompt": { "type": "string", "minLength": 1 },
        "negative_prompt": { "type": "string" },
        "output_media_id": { "$ref": "#/$defs/id" },
        "input_media_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "status": { "enum": ["pending", "runtime_pending", "resolved", "failed"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type"],
      "properties": {
        "source_type": { "enum": ["generated", "uploaded", "extracted", "external"] }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "status", "source_type", "source_job", "related_segments", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["image", "frame", "video", "audio"] },
        "role": { "enum": ["character_reference", "location_reference", "style_reference", "first_frame", "last_frame_target", "actual_tail_frame", "video_reference", "audio_reference"] },
        "status": { "enum": ["pending", "runtime_pending", "resolved", "failed"] },
        "source_type": { "enum": ["generated", "uploaded", "extracted", "external"] },
        "source_job": { "$ref": "#/$defs/nullableId" },
        "related_segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "provenance": { "$ref": "#/$defs/provenance" },
        "path": { "type": "string", "minLength": 1 },
        "runtime_handle": { "type": "string", "minLength": 1 },
        "derived_from_segment_id": { "$ref": "#/$defs/id" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": { "anyOf": [{ "required": ["path"] }, { "required": ["runtime_handle"] }] }
        },
        {
          "if": { "properties": { "role": { "const": "actual_tail_frame" } }, "required": ["role"] },
          "then": {
            "required": ["derived_from_segment_id"],
            "properties": {
              "type": { "const": "frame" },
              "source_type": { "const": "extracted" },
              "source_job": { "type": "null" },
              "status": { "enum": ["runtime_pending", "resolved", "failed"] }
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "last_frame_target" } }, "required": ["role"] },
          "then": { "properties": { "type": { "enum": ["image", "frame"] }, "source_type": { "enum": ["generated", "uploaded", "external"] } } }
        }
      ]
    },
    "mediaManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "media"],
      "properties": {
        "status": { "enum": ["draft", "ready_for_compile", "runtime_resolving", "resolved", "failed"] },
        "media": { "type": "array", "items": { "$ref": "#/$defs/media" } }
      }
    }
  }
}
